<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
    <metadata>
        <!-- required: -->
        <id>SiddiqSoft.TimeThis</id>
        <version>$VERSION$</version>
        <authors>Abdulkareem Siddiq</authors>
        <description>Lightweight, header-only C++23 stopwatch utility for measuring code execution time with optional callbacks</description>
        <summary>Header-only C++23 stopwatch and execution timer</summary>
        <tags>stopwatch timer execution-time chrono C++23 header-only native nativepackage</tags>
        <projectUrl>https://github.com/SiddiqSoft/TimeThis</projectUrl>
        <repository type="git" url="https://github.com/SiddiqSoft/TimeThis" />
        <requireLicenseAcceptance>true</requireLicenseAcceptance>
        <license type="expression">BSD-3-Clause</license>
        <icon>docs\Siddiq-Software-Avatar.png</icon>
        <readme>docs\README.md</readme>
        <releaseNotes>
## v$VERSION$ Release

For detailed release notes, visit: https://github.com/SiddiqSoft/TimeThis/releases
        </releaseNotes>
        <copyright>Copyright (c) 2021-2026 Abdulkareem Siddiq</copyright>
        <!-- Dependencies -->
        <dependencies>
        </dependencies>
    </metadata>

    <files>
        <!-- includes -->
        <file src="..\include\siddiqsoft\*.hpp" target="build\native\include\siddiqsoft\" />
        <file src="..\include\siddiqsoft\**\*.hpp" target="build\native\include\siddiqsoft\" />
        <file src="Siddiq-Software-Avatar.png" target="docs\" />
        <file src="..\README.md" target="docs\" />
        <file src="..\docs\**\*.md" target="docs\" />

        <!-- Natvis visualizer -->
        <file src="..\siddiqsoft.timethis.natvis" target="build\native\siddiqsoft.timethis.natvis" />

        <!-- MSBuild .targets files -->
        <file src="SiddiqSoft.TimeThis.targets" target="build\native" />
    </files>
</package>
